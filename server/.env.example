# Civic Sense server environment template.
# Copy to .env and fill in real values. NEVER commit .env (it's gitignored).
#
# Every variable below is consumed by app/config.py. Boot fails fast if a
# required var is missing or left at a dev placeholder in production mode —
# see config.py for the exact checks.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Async SQLAlchemy URL for the primary database (Postgres + PostGIS).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# The dev default below points at the docker-compose Postgres on port 5433.
DATABASE_URL=postgresql+asyncpg://civicsense:civicsense@localhost:5433/civicsense

# Test database — pytest creates/drops the schema here. Must be a SEPARATE
# database from DATABASE_URL or tests will truncate production data.
TEST_DATABASE_URL=postgresql+asyncpg://civicsense:civicsense@localhost:5433/civicsense_test

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# HMAC secret used to sign session JWTs (HS256, 7-day TTL).
# REQUIRED in production. Boot FAILS FAST with RuntimeError if
# DEV_AUTH_BYPASS=false and JWT_SECRET is still the dev placeholder.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me

# Google OAuth 2.0 Web Client ID (used as the expected `aud` when verifying
# Google-issued id_tokens). Get one from
# https://console.cloud.google.com/apis/credentials
# Required when DEV_AUTH_BYPASS=false.
GOOGLE_CLIENT_ID=

# Dev-only: when true, POST /auth/google accepts the literal string "dev" as
# id_token and mints a session without calling Google. NEVER enable in prod.
# Boot FAILS FAST if this is false AND JWT_SECRET is the dev placeholder,
# and if this is true while APP_ENV is production.
DEV_AUTH_BYPASS=false

# development | test | production (default). Only development and test may
# turn DEV_AUTH_BYPASS on.
APP_ENV=production

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Server-side directory where uploaded (EXIF-stripped, blurred) photos are
# written. Must be writable by the uvicorn process. Filenames are
# server-generated uuids; client filenames are never used on disk.
UPLOAD_DIR=./uploads
